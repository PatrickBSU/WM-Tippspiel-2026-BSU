# Supabase (von supabase.com Projekt-Settings)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# football-data.org API Key (kostenlos: https://www.football-data.org/client/register)
